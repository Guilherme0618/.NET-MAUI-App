<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="GerentProjeto.Pages.Func_Funcionario.Funcionalidades_Funcionario"
             BackgroundColor="#e3dde3"
             BackgroundImageSource="plano_fundo.png">

    <VerticalStackLayout Spacing="30" Padding="30">

   
        <Label 
            Text="Logado como Funcionário"
            TextColor="Black"
            FontSize="25"
            HorizontalOptions="Center" 
            Margin="0,0,0,170"/>

 
        <Grid ColumnDefinitions="Auto, Auto" RowDefinitions="Auto, Auto" HorizontalOptions="Center" ColumnSpacing="30" RowSpacing="20">

   
            <Button
                Grid.Row="0"
                Grid.Column="0"
                Text="Atividades"
                BackgroundColor="#3a89c9"
                TextColor="Black"
                FontAttributes="Bold"
                HeightRequest="45"
                WidthRequest="200"
                Clicked="OnAtividadeClicked" >
                <Button.Triggers>
                    <Trigger TargetType="Button" Property="IsPressed" Value="True">
                        <Setter Property="BackgroundColor" Value="#555"/>
                        <Setter Property="TextColor" Value="LightGray"/>
                    </Trigger>
                </Button.Triggers>
            </Button>

 
            <Button
                Grid.Row="0"
                Grid.Column="1"
                Text="Menu de Horas"
                BackgroundColor="#3a89c9"
                TextColor="Black"
                FontAttributes="Bold"
                HeightRequest="45"
                WidthRequest="200"
                Clicked="OnHorasClicked" >
                <Button.Triggers>
                    <Trigger TargetType="Button" Property="IsPressed" Value="True">
                        <Setter Property="BackgroundColor" Value="#555"/>
                        <Setter Property="TextColor" Value="LightGray"/>
                    </Trigger>
                </Button.Triggers>
            </Button>


            <Button
                Grid.Row="1"
                Grid.Column="0"
                Text="Visualizar Anotações"
                BackgroundColor="#3a89c9"
                TextColor="Black"
                FontAttributes="Bold"
                HeightRequest="45"
                WidthRequest="200"
                Clicked="OnAnotacaoClicked">
                <Button.Triggers>
                    <Trigger TargetType="Button" Property="IsPressed" Value="True">
                        <Setter Property="BackgroundColor" Value="#555"/>
                        <Setter Property="TextColor" Value="LightGray"/>
                    </Trigger>
                </Button.Triggers>
            </Button>

        </Grid>

    </VerticalStackLayout>
</ContentPage>
